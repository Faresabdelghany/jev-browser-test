# secrets — the runner reads TYPESAFE_API_KEY and app credentials from the environment, never from the repo
.env
.env.*
*.storage-state.json

# local environment
.venv/
venv/
__pycache__/
*.pyc
.DS_Store

# run artifacts: traces contain page text and screenshots of your app
runs/

# specs for a genuinely private application (its URLs, flows, account handles): local only, never in the public
# repo. Specs for public demo and practice sites are committed under specs/examples/.
specs/local/
