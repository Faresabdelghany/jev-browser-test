# secrets — the runner reads TYPESAFE_API_KEY and app credentials from the environment, never from the repo
.env
.env.*
*.storage-state.json

# local environment
.venv/
venv/
__pycache__/
*.pyc
.DS_Store

# run artifacts: traces contain page text and screenshots of your app
runs/
# what the runner keeps between runs (saved paths for --replay): local state; the directory also ignores itself
.jev/
# another tool's session artifacts (the playwright-cli skill writes page snapshots here)
.playwright-cli/

# specs for a genuinely private application (its URLs, flows, account handles): local only, never in the public
# repo. Specs for public demo and practice sites are committed under specs/examples/.
specs/local/

# the dev-docs branch checked out beside the skill (git worktree add dev origin/dev-docs): docs/ and evals/
dev/
