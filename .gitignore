# secrets — the runner reads TYPESAFE_API_KEY and app credentials from the environment, never from the repo
.env
.env.*
*.storage-state.json

# local environment
.venv/
venv/
__pycache__/
*.pyc
.DS_Store

# run artifacts: traces contain page text and screenshots of your app
runs/

# specs for a real application (URLs, flows, account handles): local only, never in the public repo
specs/local/
